# Copy this to .env and fill in your values

# MongoDB Atlas (get from atlas.mongodb.com)
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=smartshape_prod

# Auth — generate a strong random string (64+ chars)
JWT_SECRET=change-this-to-a-long-random-secret

# Admin account created on first startup
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-strong-password

# Frontend URL (set after Netlify deploy)
FRONTEND_URL=https://your-app.netlify.app

# Backend public URL — used for the School Portal Google OAuth callback and magic-link verify.
# Defaults to FRONTEND_URL if unset. Set to the API's public origin (e.g. https://api.smartshape.in).
BACKEND_PUBLIC_URL=

# Optional — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WhatsApp team numbers (spec 2026-09-24 W1) ────────────────────────────────
# Evolution on the docker network — never the public IP.
EVOLUTION_API_URL=http://smartshape_evolution:8080
# = AUTHENTICATION_API_KEY in .env.evolution
EVOLUTION_API_KEY=
# The company number's Evolution instance
WHATSAPP_INSTANCE=smartshape
# Webhook shared secret: openssl rand -hex 24. Unset = every webhook is refused.
WA_WEBHOOK_SECRET=
WA_WEBHOOK_BASE=https://app.smartshape.in
